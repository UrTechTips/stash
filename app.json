{
  "expo": {
    "name": "Stash",
    "slug": "stash",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "stash",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "me.sreenadh.stash"
    },
    "android": {
      "package": "me.sreenadh.stash",
      "adaptiveIcon": {
        "backgroundColor": "#0A3A2E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A3A2E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "expo-asset",
      [
        "expo-notifications",
        {
          "color": "#0A3A2E"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock Stash with Face ID."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "useLegacyPackaging": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "description": "A personal money manager that tells you what you can safely spend today, and whether a purchase is safe.",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "93c37634-2b0c-4242-8446-7a04a290956e"
      }
    }
  }
}
